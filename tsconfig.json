{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": false,

    "jsx": "react-native",
    "module": "ESNext",
    "target": "ES2017",

    "moduleResolution": "node",
    "types": ["react", "react-native"],

    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}